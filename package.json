{
  "name": "guitar-hero",
  "private": true,
  "version": "0.1.0",
  "description": "완전 초보 어쿠스틱 기타 학습자용 체계적 연습 웹앱 (local-first PWA)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.worklet.json",
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run",
    "bench:dsp:dev": "tsx tools/bench/run.ts --split dev",
    "bench:dsp": "tsx tools/bench/run.ts --split test",
    "bench:guitarset": "tsx tools/guitarset/bench.ts",
    "bench:real": "tsx tools/bench/real.ts",
    "fixtures:generate": "tsx tools/fixtures/generate.ts",
    "licenses": "tsx tools/licenses.ts",
    "test:e2e": "playwright test",
    "verify": "tsx tools/verify.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tonal": "^6.5.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "~1.3.0",
    "vitest": "^5.0.3"
  }
}
